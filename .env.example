# Copy to .env. Keep the key local. Set an actual model ID from your provider.
JAB_AI_BASE_URL=https://openrouter.ai/api/v1
JAB_AI_MODEL=anthropic/claude-sonnet-5.5
JAB_AI_TAILOR_MODEL=anthropic/claude-sonnet-5.5
JAB_AI_COVER_LETTER_MODEL=anthropic/claude-sonnet-5.5
# Optional model for base resume organisation; blank uses JAB_AI_MODEL.
JAB_AI_RESUME_MODEL=openai/gpt-6-luna-pro
# Optional model for job intake; blank uses JAB_AI_MODEL.
JAB_AI_JOB_MODEL=openai/gpt-6-luna-pro
# Legacy compatibility setting; document preparation no longer calls an AI reviewer.
JAB_AI_REVIEW_MODEL=
# Resume revisions use this model; cover-letter revisions use JAB_AI_COVER_LETTER_MODEL.
JAB_AI_REVISION_MODEL=anthropic/claude-sonnet-5.5
JAB_AI_API_KEY=
# Required for job URL imports and optional cover-letter company research.
JAB_ZYTE_API_KEY=
# Research uses the cover-letter model for drafts and revisions, with searches and page reads through Zyte.
JAB_COVER_LETTER_RESEARCH_ENABLED=true
JAB_RESEARCH_MAX_SEARCHES=5
JAB_RESEARCH_MAX_PAGES=8
JAB_RESEARCH_TIMEOUT=300
JAB_ZYTE_SEARCH_DOMAIN=google.com
JAB_AI_RESPONSE_FORMAT=prompt_json
JAB_AI_MAX_OUTPUT_TOKENS=8192
JAB_AI_TIMEOUT=120
# Relative database paths are resolved against the Jab directory.
JAB_DATABASE=data/jab.sqlite3
JAB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
